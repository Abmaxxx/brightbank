# Copy to .env and fill in. Do not commit .env.

DOCKERHUB_USER=your_dockerhub_username
TAG=replace_with_7_char_sha_from_docker_hub

# MySQL (used by compose / backend)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=brightbank
MYSQL_USER=brightbank
MYSQL_PASSWORD=changeme_app

# Backend DB connection (same values Compose injects on the app network)
DB_HOST=mysql
DB_PORT=3306
DB_USER=brightbank
DB_PASSWORD=changeme_app
DB_NAME=brightbank
PORT=5000
